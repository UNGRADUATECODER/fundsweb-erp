generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  SALES_USER
}

enum EnquiryStatus {
  OPEN
  QUOTED
  CLOSED
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

enum SalesOrderStatus {
  CREATED
  CONFIRMED
  DISPATCHED
  CANCELLED
}

enum DispatchStatus {
  PENDING
  DISPATCHED
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(SALES_USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  quotations  Quotation[]
  salesOrders SalesOrder[]
}

model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  email     String?
  phone     String
  address   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enquiries CustomerEnquiry[]
  orders    SalesOrder[]
}

model CustomerEnquiry {
  id         Int           @id @default(autoincrement())
  customerId Int
  subject    String?
  status     EnquiryStatus @default(OPEN)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  customer   Customer      @relation(fields: [customerId], references: [id])
  items      EnquiryItem[]
  quotations Quotation[]
}

model EnquiryItem {
  id        Int @id @default(autoincrement())
  enquiryId Int
  productId Int
  quantity  Int

  enquiry CustomerEnquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])

  @@unique([enquiryId, productId])
}

model Product {
  id            Int      @id @default(autoincrement())
  sku           String   @unique
  name          String
  description   String?
  unitPrice     Decimal  @db.Decimal(12, 2)
  gstPercentage Decimal  @db.Decimal(5, 2)
  physicalQty   Int      @default(0)
  reservedQty   Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  enquiryItems   EnquiryItem[]
  quotationItems QuotationItem[]
  orderItems     SalesOrderItem[]
}

model Quotation {
  id          Int             @id @default(autoincrement())
  enquiryId   Int
  createdById Int
  status      QuotationStatus @default(DRAFT)
  discount    Decimal         @default(0) @db.Decimal(12, 2)
  subtotal    Decimal         @default(0) @db.Decimal(12, 2)
  gstAmount   Decimal         @default(0) @db.Decimal(12, 2)
  totalAmount Decimal         @default(0) @db.Decimal(12, 2)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  enquiry   CustomerEnquiry @relation(fields: [enquiryId], references: [id])
  createdBy User            @relation(fields: [createdById], references: [id])
  items     QuotationItem[]
  order     SalesOrder?
}

model QuotationItem {
  id          Int     @id @default(autoincrement())
  quotationId Int
  productId   Int
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
  lineTotal   Decimal @db.Decimal(12, 2)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])

  @@unique([quotationId, productId])
}

model SalesOrder {
  id          Int              @id @default(autoincrement())
  quotationId Int              @unique
  customerId  Int
  createdById Int
  status      SalesOrderStatus @default(CREATED)
  totalAmount Decimal          @db.Decimal(12, 2)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  quotation  Quotation        @relation(fields: [quotationId], references: [id])
  customer   Customer         @relation(fields: [customerId], references: [id])
  createdBy  User             @relation(fields: [createdById], references: [id])
  items      SalesOrderItem[]
  dispatches Dispatch[]
}

model SalesOrderItem {
  id           Int     @id @default(autoincrement())
  salesOrderId Int
  productId    Int
  quantity     Int
  unitPrice    Decimal @db.Decimal(12, 2)
  lineTotal    Decimal @db.Decimal(12, 2)

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id])

  @@unique([salesOrderId, productId])
}

model Dispatch {
  id           Int            @id @default(autoincrement())
  salesOrderId Int
  status       DispatchStatus @default(PENDING)
  dispatchedAt DateTime?
  createdAt    DateTime       @default(now())

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id])
}
